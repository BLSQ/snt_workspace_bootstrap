{
  "permissions": {
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch --delete:*)",
      "Bash(git tag -d:*)",
      "Bash(git tag --delete:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore:*)",
      "Bash(git reflog delete:*)",
      "Bash(git reflog expire:*)",
      "Bash(git update-ref -d:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(gh pr close:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-destructive-git.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
